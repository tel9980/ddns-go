# syntax=docker/dockerfile:1

# Optimized, source-built image for personal Dockge deployments.
# Builds a static Go binary and runs as an unprivileged user with a
# dedicated writable config directory.

FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS builder

ARG TARGETOS
ARG TARGETARCH
ARG TARGETVARIANT
ARG VERSION=dev

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN GOOS="${TARGETOS:-linux}" \
    GOARCH="${TARGETARCH:-amd64}" \
    GOARM="${TARGETVARIANT#v}" \
    CGO_ENABLED=0 \
    go build -trimpath \
      -ldflags="-s -w -X main.version=${VERSION} -extldflags=-static" \
      -o /out/ddns-go .

FROM alpine:3.22

LABEL org.opencontainers.image.title="ddns-go (Dockge optimized)" \
      org.opencontainers.image.description="Optimized ddns-go image for personal Dockge stacks" \
      org.opencontainers.image.source="https://github.com/tel9980/ddns-go" \
      org.opencontainers.image.licenses="MIT"

# Runtime packages (conservative set):
#   - ca-certificates: TLS trust for outbound DDNS provider calls.
#   - tini:           PID 1 signal reaping/forwarding; Go handles SIGTERM itself,
#                     but keeping tini is the safer choice for container shutdown.
#   - tzdata:         Go 1.26 does not embed timezone data unless time/tzdata is
#                     imported; keep it so TZ=Asia/Shanghai works reliably.
#   - curl:           REMOVED. alpine's busybox already provides wget, which is
#                     enough for the local /healthz check below; one less package.
RUN apk add --no-cache ca-certificates tini tzdata \
    && apk upgrade --no-cache \
    && addgroup -g 10001 -S ddns \
    && adduser -u 10001 -S -G ddns -h /config ddns \
    && mkdir -p /config \
    && chown -R ddns:ddns /config

ENV TZ=Asia/Shanghai \
    DDNS_CONFIG_FILE_PATH=/config/.ddns_go_config.yaml

WORKDIR /app
COPY --from=builder /out/ddns-go /app/ddns-go

USER ddns:ddns
EXPOSE 9876

# busybox wget ships with alpine; no curl needed. /healthz is the fork's
# lightweight health endpoint (added alongside the login hardening).
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:9876/healthz || exit 1

ENTRYPOINT ["/sbin/tini", "--", "/app/ddns-go"]
CMD ["-l", ":9876", "-f", "300", "-c", "/config/.ddns_go_config.yaml"]
